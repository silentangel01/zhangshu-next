# 章枢 (Zhangshu) 环境变量配置
# 复制此文件为 .env 并填入实际值：cp .env.example .env

# --- 阿里云百炼 DashScope（云端精准索引）---
# 必填：API Key，从 https://bailian.console.aliyun.com/ 获取
ZHANGSHU_DASHSCOPE_API_KEY=

# 可选：模型名称（默认 text-embedding-v4）
# ZHANGSHU_DASHSCOPE_EMBEDDING_MODEL=text-embedding-v4

# 可选：向量维度（默认 1024）
# ZHANGSHU_DASHSCOPE_EMBEDDING_DIM=1024

# 可选：API 地址（默认阿里云 OpenAI 兼容端点）
# ZHANGSHU_DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1

# --- 数据存储（通常不需要改）---
# ZHANGSHU_DATA_DIR=
# ZHANGSHU_DB_FILENAME=

# --- 章枢云服务（云端备份）---
# 章枢云 API 服务端地址，部署后填入你的服务器域名或 IP
# ZHANGSHU_CLOUD_API_BASE_URL=https://api.emailbs.xin
