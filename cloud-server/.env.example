DATABASE_URL=postgresql+psycopg://zhangshu:zhangshu@postgres:5432/zhangshu_cloud
JWT_SECRET_KEY=change-me-in-production
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60
JWT_REFRESH_TOKEN_EXPIRE_DAYS=30
BCRYPT_ROUNDS=12
OSS_ACCESS_KEY_ID=your-access-key-id
OSS_ACCESS_KEY_SECRET=your-access-key-secret
OSS_BUCKET_NAME=zhangshu-backups
OSS_ENDPOINT=oss-cn-hangzhou.aliyuncs.com
# Optional: separate public/internal endpoints for dual-stack deployments.
# Public endpoint is used for presigned URLs given to clients (must be internet-reachable).
# Internal endpoint is used for server-side OSS operations (head/delete) — can use VPC/internal endpoint.
# If not set, both fall back to OSS_ENDPOINT.
OSS_PUBLIC_ENDPOINT=oss-cn-hangzhou.aliyuncs.com
OSS_INTERNAL_ENDPOINT=oss-cn-hangzhou-internal.aliyuncs.com
OSS_PRESIGNED_URL_EXPIRE_SECONDS=1800
MAX_BACKUP_SIZE_BYTES=524288000
CORS_ORIGINS=http://localhost:5180,http://127.0.0.1:5180,http://localhost:5173,http://127.0.0.1:5173

# --- Production Hardening ---
# Set to "production" to enable strict config validation
ENVIRONMENT=development
FORCE_HTTPS=true
LOG_LEVEL=INFO
ACCESS_LOG_JSON=true
# Rate limits
RATE_LIMIT_LOGIN_PER_5M=10
RATE_LIMIT_BACKUP_INIT_PER_HOUR=30
RATE_LIMIT_EMAIL_CHECK_PER_5M=20
RATE_LIMIT_EMAIL_CODE_SEND_PER_5M=5
RATE_LIMIT_EMAIL_CODE_VERIFY_PER_5M=10
# Per-user quotas
DEFAULT_STORAGE_QUOTA_BYTES=1073741824
DEFAULT_BACKUP_COUNT_QUOTA=100

# --- Auth Email Verification ---
# Development can use log mode; production must use smtp with real credentials.
EMAIL_DELIVERY_MODE=log
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_USE_TLS=true
SMTP_USE_SSL=false
AUTH_EMAIL_CODE_SECRET=
AUTH_EMAIL_CODE_LENGTH=6
AUTH_EMAIL_CODE_TTL_SECONDS=600
AUTH_EMAIL_CODE_RESEND_COOLDOWN_SECONDS=60
AUTH_EMAIL_CODE_MAX_ATTEMPTS=5

# --- Auth Phone Verification ---
# Development can use log mode; production should use aliyun with real SMS credentials.
PHONE_AUTH_ENABLED=false
SMS_DELIVERY_MODE=log
ALIYUN_SMS_ACCESS_KEY_ID=
ALIYUN_SMS_ACCESS_KEY_SECRET=
ALIYUN_SMS_SIGN_NAME=
ALIYUN_SMS_TEMPLATE_CODE=
ALIYUN_SMS_REGION_ID=cn-hangzhou
ALIYUN_SMS_ENDPOINT=https://dysmsapi.aliyuncs.com/
AUTH_PHONE_CODE_SECRET=
AUTH_PHONE_CODE_LENGTH=6
AUTH_PHONE_CODE_TTL_SECONDS=600
AUTH_PHONE_CODE_RESEND_COOLDOWN_SECONDS=60
AUTH_PHONE_CODE_MAX_ATTEMPTS=5

# OAuth login (WeChat / QQ)
OAUTH_PUBLIC_BASE_URL=https://api.zhangshu.xin
OAUTH_SESSION_TTL_SECONDS=600
WECHAT_OAUTH_ENABLED=false
WECHAT_OAUTH_APP_ID=
WECHAT_OAUTH_APP_SECRET=
QQ_OAUTH_ENABLED=false
QQ_OAUTH_APP_ID=
QQ_OAUTH_APP_SECRET=

# --- Admin ---
# Comma-separated list of admin emails. These users get admin privileges automatically.
ADMIN_EMAILS=admin@example.com

# --- Feedback ---
FEEDBACK_MAX_ATTACHMENTS=5
FEEDBACK_MAX_ATTACHMENT_SIZE_BYTES=52428800
FEEDBACK_MAX_TOTAL_SIZE_BYTES=157286400
FEEDBACK_ALLOWED_CONTENT_TYPES=image/png,image/jpeg,image/webp,image/gif,video/mp4,video/webm,video/quicktime
RATE_LIMIT_FEEDBACK_CREATE_PER_HOUR=5
RATE_LIMIT_FEEDBACK_UPLOAD_PER_HOUR=20
FEEDBACK_ATTACHMENT_URL_EXPIRE_SECONDS=1800
